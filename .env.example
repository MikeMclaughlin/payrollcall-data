# Get a free key: https://api.congress.gov/sign-up/
# (same signup as https://api.data.gov/signup/ )
CONGRESS_GOV_API_KEY=your_api_key_here

# Optional: minimum milliseconds between Congress.gov requests (default 800).
# 5000 requests/hour official cap ≈ 720ms/request; 800ms leaves headroom.
# CONGRESS_GOV_MIN_INTERVAL_MS=800

# Optional: minimum milliseconds between senate.gov XML requests (default 150).
# SENATE_XML_MIN_INTERVAL_MS=150
